#!/usr/bin/env bash

set -o errexit
set -o pipefail
set -o nounset
if [[ ${TRACE-} == "1" ]]; then
    set -o xtrace
fi

readonly BIN_DIR=~/.local/bin
readonly LINK_NAME=$BIN_DIR/go
readonly TEMP_LINK=${LINK_NAME}_tmp

CURRENT_VERSION=
if [[ -f ~/.local/bin/go ]]; then
    CURRENT_VERSION=$(basename "$(readlink ~/.local/bin/go)")
fi

if [[ $# -eq 0 ]]; then
    SELECTED_VERSION=$(find ~/sdk/ -maxdepth 1 -type d -name 'go*' -printf "%f\n" | fzf)
else
    SELECTED_VERSION=$1
    SELECTED_VERSION=go${SELECTED_VERSION#go*}
    if [[ ! -d ~/sdk/$SELECTED_VERSION ]]; then
        go install "golang.org/dl/$SELECTED_VERSION@latest"
        $SELECTED_VERSION download
    fi
fi

if [[ $SELECTED_VERSION != "$CURRENT_VERSION" ]]; then
    trap 'rm -f $TEMP_LINK' ERR
    ln -s ~/.local/go/bin/"$SELECTED_VERSION" $TEMP_LINK
    mv -T $TEMP_LINK $LINK_NAME
fi
