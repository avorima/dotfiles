#!/usr/bin/env bash

set -o errexit
set -o pipefail
set -o nounset
if [[ ${TRACE-} == "1" ]]; then
    set -o xtrace
fi

readonly BIN_DIR=~/.local/bin

atomic_link() {
    local src=$1
    local dst=$2
    local temp="${dst}_tmp"
    if ! ln -s "$src" "$temp"; then
        rc=$?
        rm -f "$temp"
        return $rc
    fi
    if ! mv -T "$temp" "$dst"; then
        rc=$?
        rm -f "$temp"
        return $rc
    fi
}

CURRENT_VERSION=
if [[ -f ~/.local/bin/go ]]; then
    CURRENT_VERSION=$(basename "$(readlink ~/.local/bin/go)")
fi

if [[ $# -eq 0 ]]; then
    SELECTED_VERSION=$(find ~/sdk/ -maxdepth 1 -type d -name 'go*' -printf "%f\n" | sort | fzf)
else
    SELECTED_VERSION=$1
    SELECTED_VERSION=go${SELECTED_VERSION#go*}
    if [[ ! -d ~/sdk/$SELECTED_VERSION ]]; then
        go install "golang.org/dl/$SELECTED_VERSION@latest"
        $SELECTED_VERSION download
    fi
fi

if [[ $SELECTED_VERSION != "$CURRENT_VERSION" ]]; then
    atomic_link ~/.local/go/bin/"$SELECTED_VERSION" $BIN_DIR/go
    atomic_link ~/sdk/"$SELECTED_VERSION"/bin/gofmt $BIN_DIR/gofmt
fi
